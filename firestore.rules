rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(shopId) {
      return isSignedIn() && request.auth.uid == shopId;
    }

    function isEmployeeOf(shopId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.shopId == shopId;
    }

    function onlyProfileFieldsChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["shopName", "ownerName", "phone"]);
    }

    function employeeCustomerWriteAllowed() {
      let beforeTx = resource.data.transactions;
      let afterTx = request.resource.data.transactions;
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return afterTx.size() > beforeTx.size() && changedKeys.hasOnly(["transactions"]);
    }

    function employeeProductWriteAllowed() {
      return request.resource.data.price == resource.data.price;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /employees/{uid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || isAdmin() || isOwner(resource.data.shopId));
      allow create: if isSignedIn() && isOwner(request.resource.data.shopId);
      allow update: if false;
      allow delete: if isSignedIn() && (isOwner(resource.data.shopId) || isAdmin());
    }

    match /shops/{shopId} {
      allow read: if isOwner(shopId) || isAdmin() || isEmployeeOf(shopId);
      allow create: if isOwner(shopId)
                    && request.resource.data.status == "pending";
      allow update: if isAdmin() || (isOwner(shopId) && onlyProfileFieldsChanged());
      allow delete: if isAdmin();

      match /customers/{customerId} {
        allow read: if isOwner(shopId) || isEmployeeOf(shopId);
        allow create: if isOwner(shopId);
        allow update: if isOwner(shopId) ||
          (isEmployeeOf(shopId) && employeeCustomerWriteAllowed());
        allow delete: if isOwner(shopId);
      }

      match /activity_log/{entryId} {
        allow read: if isOwner(shopId) || isAdmin();
        allow create: if isOwner(shopId) || isEmployeeOf(shopId);
        allow update, delete: if false;
      }

      match /products/{productId} {
        allow read: if isOwner(shopId) || isEmployeeOf(shopId);
        allow create, delete: if isOwner(shopId) || isEmployeeOf(shopId);
        allow update: if isOwner(shopId) ||
          (isEmployeeOf(shopId) && employeeProductWriteAllowed());
      }
    }

    match /known_devices/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /shop_registry/{shopId} {
      allow read: if true;
      allow create: if isOwner(shopId);
      allow update, delete: if false;
    }
  }
}
